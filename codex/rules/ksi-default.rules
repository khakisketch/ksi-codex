# KSI Codex safe command policy.
# These rules are intentionally conservative and can be extended per user or project.

prefix_rule(pattern=["git", "push"], decision="prompt", justification="Pushing code changes should be an explicit user decision.")
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden", justification="Force push is blocked by default. Ask the user for explicit approval and use a project-specific override if needed.")
prefix_rule(pattern=["sudo"], decision="prompt", justification="Privilege escalation requires explicit review.")
prefix_rule(pattern=["rm", "-rf"], decision="prompt", justification="Recursive deletion can destroy work and should be reviewed.")
